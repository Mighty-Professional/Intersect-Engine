{
	"Api": {
		"AllowedNetworkTypes": 0,
		"Enabled": true,
		"StaticFilePaths": [
			{
				"SourcePath": "wwwroot"
			}
		]
	},
	"DetailedErrors": false,
	"Kestrel": {
		"AddServerHeader": false,
		"AllowResponseHeaderCompression": true,
		"DisableStringReuse": false,
		"Endpoints": {
			"Http": {
				"Url": "http://0.0.0.0:5400"
			}
		},
		"Limits": {
			"MaxConcurrentConnections": 100,
			"MaxConcurrentUpgradedConnections": 100
		}
	},
	"Logging": {
		"Common": {
			"MinimumLevel": {
				"Default": "Error",
				"Override": {
					"Intersect": "Warning",
					"Microsoft": "Warning",
					"System": "Warning"
				}
			}
		}
	}
}
